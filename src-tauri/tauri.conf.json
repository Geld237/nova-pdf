{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nova PDF",
  "mainBinaryName": "nova-pdf",
  "version": "../package.json",
  "identifier": "io.github.geld237.novapdf",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nova PDF",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Georges Eloundou",
    "copyright": "© 2026 Georges Eloundou — MIT",
    "category": "Productivity",
    "shortDescription": "Lecteur PDF libre et privé avec IA locale",
    "longDescription": "Nova PDF lit, annote, signe, organise, convertit et protège vos PDF, avec une IA qui tourne entièrement sur votre ordinateur.",
    "homepage": "https://github.com/Geld237/nova-pdf",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "Document PDF",
        "description": "Document PDF",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "office"
      }
    }
  }
}