{
  "name": "nova-pdf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "version:sync": "node scripts/sync-version.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "tauri": "tauri"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
