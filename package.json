  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "description": "Lecteur PDF libre, rapide et privé, avec IA locale — tout dans le navigateur.",
  "license": "MIT",
  "keywords": [
    "pdf",
    "pdf-reader",
    "pdf-editor",
    "ocr",
    "local-ai",
